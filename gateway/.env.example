PORT=4000
DEMO_MODE=false

# Broker MQTT / TTN
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
# Opcional: tópico de TTN que se desea escuchar
# TTN_TOPIC=v3/turbidez-app@ttn/devices/+/up

# MongoDB
MONGO_URL=mongodb+srv://usuario:clave@cluster.mongodb.net/
# MONGO_DB=Monitoreo_Agua

# Secreto para firmar los tokens de sesión
TOKEN_SECRET=cambia-este-valor-por-uno-largo-y-aleatorio

# Asistente con IA (OpenRouter). Sin clave, el asistente usa reglas locales.
# Crea tu clave en https://openrouter.ai/keys y no la subas a Git.
# OPENROUTER_API_KEY=sk-or-v1-tu-clave
# OPENROUTER_MODEL=google/gemini-3.5-flash-lite
# Modelos de respaldo separados por coma si el principal falla o está saturado
# OPENROUTER_FALLBACK_MODELS=upstage/solar-mini4,openrouter/free
# OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
# OPENROUTER_SITE_URL=http://localhost:4000
# OPENROUTER_APP_NAME=WaterMLdetect

# Opcional: LM Studio u otro servidor local compatible con OpenAI (se usa si no hay OPENROUTER_API_KEY)
# LLM_URL=http://192.168.18.183:1235/v1
# LLM_MODEL=qwen/qwen3.5-9b
# LLM_API_KEY=lm-studio
